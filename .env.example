# Public site URL used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.ru

# Optional: existing project backend endpoint. If set, it has priority over DeepSeek.
BEAUTY_OS_API_URL=

# Optional: DeepSeek-compatible provider settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
