# Public site URL used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.ru

# Optional: existing project backend endpoint. If set, it has priority over DeepSeek.
BEAUTY_OS_API_URL=

# Optional: DeepSeek-compatible provider settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Telegram admin statistics bot. Keep real values only in .env.local / server env.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_SECRET=change-this-long-random-secret
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_SITE_URL=https://your-domain.ru

# Closed analytics dashboard. Use unique values in production.
KRASAVITSA_ADMIN_PASSWORD=replace-with-a-long-password
KRASAVITSA_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
KRASAVITSA_ADMIN_ACCESS_KEY=replace-with-a-second-random-32-plus-character-secret
KRASAVITSA_USER_SESSION_SECRET=replace-with-another-32-character-random-secret

# Transactional mail for confirmation. Create and verify this sender in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Красавица <hello@your-domain.ru>

# Mount this directory as a persistent Dokploy volume.
ANALYTICS_DATA_DIR=/app/data
ANALYTICS_TIME_ZONE=Europe/Moscow
ANALYTICS_DIGEST_TIME=21:05
USER_DATA_DIR=/app/data
